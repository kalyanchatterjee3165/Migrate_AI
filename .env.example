# Copy this file to .env and fill in your values

# ------------------------------------------------------------------
# LLM provider — set these three to use any OpenAI-compatible API
# ------------------------------------------------------------------

# ── OpenAI (default) ──────────────────────────────────────────────
LLM_API_KEY=sk-...
# LLM_BASE_URL=                            # leave blank for OpenAI
# LLM_MODEL=gpt-4o                         # default model

# ── Google Gemini ─────────────────────────────────────────────────
# LLM_API_KEY=<google-ai-studio-key>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# ── Groq ──────────────────────────────────────────────────────────
# LLM_API_KEY=<groq-api-key>
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ── Ollama (local) ────────────────────────────────────────────────
# LLM_API_KEY=ollama                        # any non-empty string
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ── Extra headers (optional) ──────────────────────────────────────
# Sent on every request — useful for internal routing, tracking, etc.
# LLM_EXTRA_HEADERS={"use-case": "data-migration", "x-team": "platform"}

# ------------------------------------------------------------------
# App authentication (Gradio UI only)
# ------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=your-password-here

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------
LOG_LEVEL=INFO
OUTPUT_DIR=./output
